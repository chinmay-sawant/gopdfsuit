# Public by default: no auth unless explicitly opted in for Cloud Run.
# Local dev, plain Docker, and GitHub Pages builds stay public.
# To enable Google login, uncomment VITE_IS_CLOUD_RUN and set VITE_GOOGLE_CLIENT_ID.

# Google OAuth Client ID (OPTIONAL - only needed for Cloud Run auth)
# Get this from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# API Configuration
# For local development (public, no auth required)
VITE_API_URL=http://localhost:8081
# VITE_IS_CLOUD_RUN=false

# For Cloud Run deployment (opt-in auth)
# VITE_IS_CLOUD_RUN=true
# VITE_ENVIRONMENT=cloudrun
# VITE_CLOUD_RUN_URL=https://your-service-name.run.app
# VITE_API_URL=https://your-service-name.run.app
